configuration {
    show-icons: true;
}

@import "launchers/shared/colors.rasi"
@import "launchers/shared/fonts.rasi"

window {
    transparency:      "real";
    location:          center;
    anchor:            center;
    width:             620px;

    enabled:           true;
    padding:           0px;
    border:            1px solid;
    border-radius:     4px;
    border-color:      #e0e0e03d;
    background-color:  @background;
    cursor:            "default";
}

mainbox {
    enabled:           true;
    spacing:           8px;
    padding:           14px;
    background-color:  transparent;
    children:          [ "inputbar", "listview" ];
}

/* Compact single-line bar. The launcher uses a chunky 12px-padded prompt
   block; this stays slim so the list dominates. */
inputbar {
    enabled:           true;
    spacing:           8px;
    padding:           0px;
    border:            0px 0px 1px 0px;
    border-color:      #e0e0e014;
    background-color:  transparent;
    text-color:        @foreground;
    children:          [ "prompt", "entry" ];
}

prompt {
    enabled:           true;
    padding:           0px 8px 8px 2px;
    background-color:  transparent;
    text-color:        @foreground;
}

entry {
    enabled:           true;
    padding:           0px 0px 8px 0px;
    background-color:  transparent;
    text-color:        @foreground;
    cursor:            text;
    placeholder:       "search clipboard";
    placeholder-color: @muted;
}

listview {
    enabled:           true;
    columns:           1;
    lines:             8;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    fixed-height:      false;

    spacing:           2px;
    padding:           0px;
    background-color:  transparent;
    text-color:        @foreground;
    cursor:            "default";
}

/* No per-row border — rows read as a continuous list rather than the
   launcher's discrete cards. Separation comes from spacing alone. */
element {
    enabled:           true;
    spacing:           10px;
    padding:           6px 8px;
    border:            0px solid;
    border-radius:     4px;
    background-color:  transparent;
    text-color:        @foreground;
    cursor:            pointer;
}

element normal.normal    { background-color: transparent; text-color: @foreground; }
element alternate.normal { background-color: transparent; text-color: @foreground; }

element selected.normal {
    background-color:  @background-alt;
    text-color:        @selected;
}

element-icon {
    size:              26px;
    background-color:  transparent;
    cursor:            inherit;
}

element-text {
    background-color:  transparent;
    text-color:        inherit;
    cursor:            inherit;
    vertical-align:    0.5;
    horizontal-align:  0.0;
}

error-message {
    padding:           20px;
    border:            1px solid;
    border-radius:     8px;
    border-color:      #e0e0e02b;
    background-color:  @background;
    text-color:        @foreground;
}
textbox { background-color: transparent; text-color: @foreground; }
