#!/usr/bin/env bash
# hypr-font — the font the desktop uses.
#
#   hypr-font                 print the current family
#   hypr-font list            families installed here that suit the rice
#   hypr-font set <family>    use it in the shell, terminals and monospace apps
#   hypr-font reset           back to the rice default
#   hypr-font --render        rewrite the generated files from shell.json (internal)
#
# The choice lives in ~/.config/hypr-theme/shell.json (font.family, watched by
# the shell) and is rendered into ~/.config/hypr-theme/ui/, which kitty and
# alacritty include — the repo's own terminal configs keep their defaults.
# fontconfig gets a rule so everything resolving "monospace" (Qt, GTK, nvim in
# a terminal) follows too.
set -u
DEFAULT="JetBrainsMono Nerd Font Propo"   # the shell's font; terminals get the non-Propo cut
SHELL_JSON="$HOME/.config/hypr-theme/shell.json"
UI="$HOME/.config/hypr-theme/ui"
FC="$HOME/.config/fontconfig/conf.d/99-hypr-font.conf"
TERM_BASE=11; BASE=12

get() { jq -r ".font.$1 // empty" "$SHELL_JSON" 2>/dev/null || true; }
put() {
    mkdir -p "$(dirname "$SHELL_JSON")"; [[ -f "$SHELL_JSON" ]] || printf '{}\n' > "$SHELL_JSON"
    local tmp; tmp="$(mktemp)"
    jq --arg k "$1" --arg v "$2" '.font[$k] = $v' "$SHELL_JSON" > "$tmp" && mv "$tmp" "$SHELL_JSON"
}
have_family() { fc-list -f '%{family[0]}\n' | grep -Fxqi -- "$1"; }

# Monospace families, plus the Nerd Font "Propo" variants (proportional
# spacing, what the bar is drawn with). Emoji and icon-only fonts are noise.
list() {
    { fc-list :spacing=100 -f '%{family[0]}\n'; fc-list -f '%{family[0]}\n' | grep -i "Nerd Font Propo"; } \
        | grep -v -i -E 'emoji|signwriting|symbols only|nerd font mono' | sort -u
}

render() {
    local fam size pt kfam
    fam="$(get family)"; [[ -n "$fam" ]] || fam="$DEFAULT"
    size="$(get size)";  [[ "$size" =~ ^[0-9]+$ ]] || size=$BASE
    pt="$(awk -v s="$size" -v t="$TERM_BASE" -v b="$BASE" 'BEGIN { printf "%d", int(s * t / b + 0.5) }')"
    # terminals want the mono cut of a Nerd Font, never the Propo one
    kfam="${fam% Propo}"
    mkdir -p "$UI"
    printf '# GENERATED by hypr-font / hypr-text-size. Included from kitty.conf.\nfont_family %s\nfont_size %s.0\n' "$kfam" "$pt" > "$UI/kitty.conf"
    printf '# GENERATED by hypr-font / hypr-text-size. Imported from alacritty.toml.\n[font]\nsize = %s.0\n\n[font.normal]\nfamily = "%s"\n' "$pt" "$kfam" > "$UI/alacritty.toml"
    # fontconfig: anything asking for "monospace" gets it (Qt, GTK, TUIs)
    mkdir -p "$(dirname "$FC")"
    cat > "$FC" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- GENERATED by hypr-font. Everything resolving "monospace" gets this family. -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="prepend_first" binding="strong"><string>$kfam</string></edit>
  </match>
</fontconfig>
XML
    gsettings set org.gnome.desktop.interface monospace-font-name "$kfam $pt" 2>/dev/null || true
    pkill -SIGUSR1 -x kitty 2>/dev/null || true
    command -v qs >/dev/null 2>&1 && qs ipc call theme reload >/dev/null 2>&1 || true
}

case "${1:-}" in
    "")        fam="$(get family)"; printf '%s\n' "${fam:-$DEFAULT}" ;;
    list)      list ;;
    --render)  render ;;
    reset)     put family "$DEFAULT"; render; printf 'font: %s\n' "$DEFAULT" ;;
    set)
        fam="${2:-}"; [[ -n "$fam" ]] || { echo "usage: hypr-font set <family>" >&2; exit 1; }
        have_family "$fam" || { echo "font not installed: $fam" >&2; exit 1; }
        put family "$fam"; render
        printf 'font: %s\n' "$fam"
        command -v notify-send >/dev/null && notify-send -a font "Font: $fam" "Alacritty and GTK apps need a restart" || true ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)         echo "usage: hypr-font [list|set <family>|reset]" >&2; exit 1 ;;
esac
