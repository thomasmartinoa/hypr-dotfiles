#!/usr/bin/env bash
# hypr-text-size — one knob for apparent text size across the desktop.
#
#   hypr-text-size              print the current size and what it drives
#   hypr-text-size <px>         9–20; the shell, GTK apps and terminals together
#   hypr-text-size up|down      step through the presets
#   hypr-text-size reset        back to the default (12 px)
#
# Everything is anchored to the shell's default 12 px:
#   shell   ~/.config/hypr-theme/shell.json  font.size   (watched; re-flows live)
#   GTK     gsettings text-scaling-factor, quantized so the interface font
#           lands on a whole point size (fractional sizes clip in GTK4 menus)
#   kitty / alacritty   ~/.config/hypr-theme/text-size/*, included by their
#           configs, so the repo's own font settings stay untouched
set -u
MIN=9; MAX=20; BASE=12; TERM_BASE=11           # kitty/alacritty ship 11pt at 12px
PRESETS=(9 10 11 12 13 14 16 18 20)
SHELL_JSON="$HOME/.config/hypr-theme/shell.json"
OVR="$HOME/.config/hypr-theme/text-size"
SCHEMA="org.gnome.desktop.interface"

current() { jq -r '.font.size // empty' "$SHELL_JSON" 2>/dev/null || true; }
term_pt() { awk -v s="$1" -v t="$TERM_BASE" -v b="$BASE" 'BEGIN { printf "%d", int(s * t / b + 0.5) }'; }
gtk_pt()  { local n; n="$(gsettings get "$SCHEMA" font-name 2>/dev/null)"; n="${n%\'}"; n="${n##* }"; [[ $n =~ ^[0-9.]+$ ]] && echo "$n" || echo 11; }

apply() {
    local px="$1" pt factor
    # shell
    mkdir -p "$(dirname "$SHELL_JSON")"
    [[ -f "$SHELL_JSON" ]] || printf '{}\n' > "$SHELL_JSON"
    tmp="$(mktemp)"; jq --argjson s "$px" '.font.size = $s' "$SHELL_JSON" > "$tmp" && mv "$tmp" "$SHELL_JSON"
    # GTK
    factor="$(awk -v s="$px" -v b="$BASE" -v f="$(gtk_pt)" 'BEGIN { printf "%.4f", int(f * s / b + 0.5) / f }')"
    gsettings set "$SCHEMA" text-scaling-factor "$factor" 2>/dev/null || true
    # terminals
    pt="$(term_pt "$px")"
    mkdir -p "$OVR"
    printf '# GENERATED by hypr-text-size. Included from kitty.conf.\nfont_size %s.0\n' "$pt" > "$OVR/kitty.conf"
    printf '# GENERATED by hypr-text-size. Imported from alacritty.toml.\n[font]\nsize = %s.0\n' "$pt" > "$OVR/alacritty.toml"
    pkill -SIGUSR1 -x kitty 2>/dev/null || true
    printf 'text size %s px  ·  gtk %s  ·  terminals %s pt\n' "$px" "$factor" "$pt"
    command -v notify-send >/dev/null && notify-send -a "text size" "Text size ${px}px" "GTK ×${factor} · terminals ${pt}pt · Alacritty needs a restart" || true
}

step() {
    local cur="${1:-$BASE}" dir="$2" i
    for i in "${!PRESETS[@]}"; do [[ ${PRESETS[$i]} -ge $cur ]] && break; done
    [[ ${PRESETS[$i]} -ne $cur ]] && : # nearest preset at or above current
    if [[ $dir == up ]]; then (( i < ${#PRESETS[@]} - 1 )) && ((i++)); else (( i > 0 )) && ((i--)); fi
    echo "${PRESETS[$i]}"
}

case "${1:-}" in
    "")
        cur="$(current)"; px="${cur:-$BASE}"
        printf 'text size: %s px%s\ngtk text-scaling-factor: %s\nterminal font: %s pt\n' \
            "$px" "$([[ -z $cur ]] && echo ' (default)')" \
            "$(gsettings get "$SCHEMA" text-scaling-factor 2>/dev/null)" "$(term_pt "$px")" ;;
    up|down)  apply "$(step "$(current)" "$1")" ;;
    reset)    apply "$BASE" ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        [[ ${1} =~ ^[0-9]+$ ]] && (( $1 >= MIN && $1 <= MAX )) || { echo "size must be $MIN–$MAX px" >&2; exit 1; }
        apply "$1" ;;
esac
