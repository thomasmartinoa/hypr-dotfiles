#!/usr/bin/env python3
"""hypr-scale — the focused monitor's scale: everything Wayland-native grows.

    hypr-scale                 print the focused monitor and its scale
    hypr-scale <n>             set it (1, 1.25, 1.6, 2 …)
    hypr-scale up|down         step through the presets
    hypr-scale reset           back to what monitors.lua says (hyprctl reload)

Hyprland only accepts a scale where the mode divides into whole logical
pixels (1/120 steps), so a requested value is rounded to the nearest clean
one. The change is applied live with `hyprctl eval` (the Lua config has no
`keyword`) and written into modules/monitors.lua so it survives a reload.
"""
import json, math, os, re, subprocess, sys

PRESETS = [1, 1.25, 1.5, 1.6, 1.75, 2, 2.5, 3]
LUA = os.path.expanduser("~/.config/hypr/modules/monitors.lua")


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def focused():
    for m in json.loads(hypr("monitors", "-j")):
        if m.get("focused"):
            return m
    sys.exit("no focused monitor")


def clean(scale, w, h):
    """The nearest scale Hyprland will accept for this mode."""
    g = math.gcd(w * 120, h * 120)
    k = min(int(scale * 120 + 0.5), g)
    k = max(k, 1)
    while g % k:
        k += 1
    return k / 120


def fmt(x):
    return f"{x:g}"


def persist(name, scale):
    """Rewrite this output's scale in monitors.lua, or append a rule for it."""
    try:
        src = open(LUA).read()
    except OSError:
        return
    block = re.compile(r'(hl\.monitor\(\{[^}]*?output\s*=\s*"' + re.escape(name) + r'"[^}]*?scale\s*=\s*)([0-9.]+)', re.S)
    if block.search(src):
        src = block.sub(lambda m: m.group(1) + fmt(scale), src, count=1)
    else:
        src = src.rstrip() + (
            f'\n\n-- written by hypr-scale\nhl.monitor({{ output = "{name}", '
            f'mode = "preferred", position = "auto", scale = {fmt(scale)} }})\n')
    open(LUA, "w").write(src)


def apply(scale):
    m = focused()
    s = clean(scale, m["width"], m["height"])
    mode = f'{m["width"]}x{m["height"]}@{m["refreshRate"]:.2f}'
    name = m["name"]
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        sys.exit("refusing unsafe monitor name")
    hypr("eval", f'hl.monitor({{ output = "{name}", mode = "{mode}", position = "auto", scale = {fmt(s)} }})')
    persist(name, s)
    print(f"{name}: scale {fmt(s)}" + ("" if abs(s - scale) < 1e-6 else f" (rounded from {fmt(scale)})"))
    subprocess.run(["notify-send", "-a", "display", f"Scale {fmt(s)}",
                    "XWayland apps and Qt/GTK apps need a restart to redraw"], capture_output=True)


def step(cur, direction):
    m = focused()
    opts = sorted({clean(p, m["width"], m["height"]) for p in PRESETS})
    if direction == "up":
        nxt = next((o for o in opts if o > cur + 1e-6), opts[-1])
    else:
        nxt = next((o for o in reversed(opts) if o < cur - 1e-6), opts[0])
    return nxt


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("-h", "--help"):
        print(__doc__.strip()); return
    if arg == "":
        m = focused()
        print(f'{m["name"]}  {m["width"]}x{m["height"]}@{m["refreshRate"]:.0f}  scale {fmt(m["scale"])}')
        return
    if arg == "reset":
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        print("scale back to monitors.lua")
        return
    if arg in ("up", "down"):
        apply(step(focused()["scale"], arg)); return
    try:
        apply(float(arg))
    except ValueError:
        sys.exit("usage: hypr-scale [<n>|up|down|reset]")


if __name__ == "__main__":
    main()
