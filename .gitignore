# Editor / swap files
*.swp
*.swo
*~
.DS_Store

*.log
hyprland*.log
core
*.core

.cache/
*/.config/*/cache/
zsh/.zsh_history
zsh/.zcompdump*

nvim/.config/nvim/.luarc.json
nvim/.config/nvim/spell/

.stow-local-ignore

Screenshots/*-draft.png
Screenshots/tmp*

# hypr-theme output (rendered from theme/.config/hypr-theme/templates)
theme/.config/hypr-theme/current/
theme/.config/hypr-theme/current.next/
theme/.config/hypr-theme/shell.json
# more per-machine state that lives next to it (~/.config/hypr-theme is the stow link)
theme/.config/hypr-theme/menu.local.jsonc
theme/.config/hypr-theme/defaults/
theme/.config/hypr-theme/ui/
__pycache__/
*.pyc

# themes: the rice ships these three; any other folder under themes/ is the
# user's own (made by hand or by an agent) and stays on their machine
theme/.config/hypr-theme/themes/*
!theme/.config/hypr-theme/themes/hyprmono/
!theme/.config/hypr-theme/themes/hyprmono-light/
!theme/.config/hypr-theme/themes/catppuccin-mocha/
# the maintainer's own rules for the /hypr skill (see SKILL.md); not published
theme/.config/hypr-theme/skills/hypr/MAINTAINER.md
